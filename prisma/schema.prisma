generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  avatarUrl String?
  passwordHash String
  resetToken String?
  resetTokenExpiresAt DateTime?
  resetChallengeId String? @unique
  resetCodeHash String?
  resetAttempts Int @default(0)
  resetSentAt DateTime?
  createdAt DateTime @default(now())
  sessions Session[]
  applications Application[]
  resumes Resume[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
}
model AuthAttempt {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
enum Stage {
  APPLIED
  OA
  TECHNICAL
  HR
  OFFER
  REJECTED
  WITHDRAWN
}
model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company String
  role String
  location String @default("")
  website String @default("")
  companyInfo String @default("")
  description String @default("")
  salary String @default("")
  stage Stage @default(APPLIED)
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumeId String?
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  interviews Interview[]
  notes Note[]
  reminders Reminder[]
  @@index([userId, stage, appliedAt])
}
model Interview {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title String
  startsAt DateTime
  duration Int @default(60)
  location String @default("")
  notes String @default("")
  @@index([applicationId, startsAt])
}
model Note {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body String
  createdAt DateTime @default(now())
}
model Reminder {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title String
  dueAt DateTime
  done Boolean @default(false)
  @@index([applicationId, dueAt])
}
model Resume {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  version String
  url String
  notes String @default("")
  createdAt DateTime @default(now())
  applications Application[]
  @@index([userId])
}
